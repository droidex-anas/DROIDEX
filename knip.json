{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "paths": {
    "@droidex/icons": ["packages/icons/src/index.ts"]
  },
  "entry": [
    "src/main.tsx",
    "src/features/capture/desktop/main.tsx",
    "electron/capture/desktopPreload.cjs",
    "vite.config.ts",
    "electron/*.cjs",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "project": ["src/**/*.{ts,tsx}", "electron/**/*.cjs", "*.config.{js,ts}"],
  "ignore": ["sidecar/**"],
  "ignoreBinaries": ["iconutil", "xdotool"],
  "ignoreDependencies": [
    "@types/react",
    "@types/react-dom",
    "autoprefixer",
    "postcss",
    "tailwindcss"
  ]
}
