{
  "threshold": 2,
  "minTokens": 70,
  "minLines": 8,
  "reporters": ["console", "json"],
  "output": "reports/jscpd",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/sidecar/dist/**",
    "**/package-lock.json",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.cjs"
  ]
}
