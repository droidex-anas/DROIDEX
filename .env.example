# Local development defaults. Copy to .env and override only what you need.

# Electron development shell target. Vite defaults to port 1420 for this app.
ELECTRON_START_URL=http://127.0.0.1:1420

# Optional fixed bridge port. The app generates private control and asset tokens
# for every sidecar process; they are intentionally not configurable.
BRIDGE_PORT=8765

# Optional Droid CLI override. Leave blank to use PATH discovery.
DROID_PATH=

# Optional Claude Code CLI override. Leave blank to use PATH discovery.
CLAUDE_PATH=

# Claude Code's own config directory, which holds the default model DROIDEX
# shows for a Claude chat. Leave blank for the CLI's own location.
CLAUDE_CONFIG_DIR=

# Optional Codex CLI override. Leave blank to use PATH discovery.
CODEX_PATH=

# Codex's own home, which holds the config.toml DROIDEX reads a Codex chat's
# default model from. Leave blank for the CLI's own location.
CODEX_HOME=

# Optional Factory API key for local Droid child processes.
# Never commit a real key.
FACTORY_API_KEY=

# Optional development overrides.
SIDECAR_ENTRY=
# Optional Electron profile directory override. Lets a second dev instance run
# beside your main one with its own localStorage, settings, and history state.
DROIDEX_USER_DATA_DIR=
# Optional history state directory for a bare sidecar running beside the main
# app. Electron derives this from DROIDEX_USER_DATA_DIR automatically.
DROIDEX_HISTORY_DIR=
# Keep hidden Browser sessions warm by default. Set a positive millisecond value
# to close inactive hidden views after that delay.
DROID_NATIVE_BROWSER_IDLE_MS=0
# Live native browser views: the attached session plus at most one warm hidden
# session. Older hidden sessions serialize URL/scroll/viewport/design state and
# drop their WebContents; persist:droidex-browser keeps cookies and passkeys.
DROID_NATIVE_BROWSER_MAX_LIVE=2
DROID_CONTROL_MAX_OPEN_CHILD_SESSIONS=4
# Live provider runtimes. Default matches the hard open max so four children
# still run concurrently; extra children queue instead of opening more runtimes.
DROID_CONTROL_MAX_LIVE_CHILD_RUNTIMES=4
DROID_CONTROL_MAX_QUEUED_CHILD_RUNTIMES=16
DROID_CONTROL_BROWSER_NATIVE_TIMEOUT_MS=12000
# RSS threshold for memory-pressure eviction of cold views and inactive transcripts.
DROID_MEMORY_PRESSURE_RSS_BYTES=1610612736

# Platform variables used for CLI discovery. Normally inherit these from your shell.
# PATH=/usr/local/bin:/usr/bin:/bin
# PATHEXT=.COM;.EXE;.BAT;.CMD
# ComSpec=C:\Windows\System32\cmd.exe

# Local packaging (npm run dist:mac) is unsigned unless a Developer ID identity
# is available. Production CI sets DROIDEX_RELEASE_BUILD=1 and fails closed
# unless both signing and notarization credentials are present.
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
# CSC_LINK=<base64 Developer ID Application .p12>
# CSC_KEY_PASSWORD=
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# Or use App Store Connect API credentials for notarization.
# APPLE_API_KEY=/absolute/path/to/AuthKey_KEYID.p8
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=

# Public client DSN embedded into signed release builds. Sentry auth tokens are
# CI-only secrets and must never be embedded in the app.
# SENTRY_DSN=https://public-key@your-sentry-host/project-id

# Datadog RUM, used only to count installations of packaged release builds.
# The application id and client token are client-side credentials embedded in
# the build; a Datadog API key is never used by the app and must never be set
# here. Leave blank for development: telemetry is off unless app.isPackaged.
# DATADOG_APPLICATION_ID=
# DATADOG_CLIENT_TOKEN=
# DATADOG_SITE=us5.datadoghq.com
# Set to 'release' only by the release workflow. Local packaged builds report
# 'local' so maintainer machines never count as installations.
# DROIDEX_DISTRIBUTION_CHANNEL=
# Set to 1 in an installed copy to opt that installation out entirely.
# DROIDEX_DISABLE_USAGE_ANALYTICS=
