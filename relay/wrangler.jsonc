{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "droidex-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "vars": { "WEB_ORIGIN": "https://droidex.vercel.app" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RelayRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  "ratelimits": [
    { "name": "CONNECTION_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    {
      "name": "PROFILE_READ_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
