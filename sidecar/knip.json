{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/canvas/compilerWorker.ts",
    "src/remote/host.ts",
    "src/usage/usageWorker.ts",
    "src/testing/isolatedTestEnv.ts",
