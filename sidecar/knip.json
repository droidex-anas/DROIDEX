{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/canvas/compilerWorker.ts",
    "src/testing/isolatedTestEnv.ts",
    "src/**/*.test.ts",
    "regression/**/*.test.ts"
  ],
  "project": ["src/**/*.ts", "regression/**/*.ts"],
  "ignoreBinaries": ["open"],
  "ignoreDependencies": [
    "esbuild",
    "lucide-react",
    "postcss",
    "postcss-value-parser",
    "react",
    "react-dom",
    "tailwindcss"
  ]
}
