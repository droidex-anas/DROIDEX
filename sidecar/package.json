{
  "name": "droid-control-sidecar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Node sidecar bridging the Electron frontend to the Factory droid daemon via @factory/droid-sdk",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "npm run build:main && npm run build:history-worker",
    "build:main": "esbuild src/index.ts --bundle --splitting --platform=node --format=esm --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --outdir=dist --entry-names=sidecar --chunk-names=chunks/[name]-[hash] --out-extension:.js=.mjs",
    "build:history-worker": "esbuild src/historyPersistenceWorker.ts --bundle --platform=node --format=esm --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --outfile=dist/historyPersistenceWorker.mjs",
    "test": "node --import tsx --import ./src/testing/isolatedTestEnv.ts --test --test-reporter=spec \"src/**/*.test.ts\"",
    "test:coverage": "node --import tsx --import ./src/testing/isolatedTestEnv.ts --test --experimental-test-coverage --test-coverage-lines=74 --test-coverage-branches=69 --test-coverage-functions=56 \"src/**/*.test.ts\"",
    "test:report": "mkdir -p ../reports && node --import tsx --import ./src/testing/isolatedTestEnv.ts --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=../reports/sidecar-tests.xml \"src/**/*.test.ts\"",
    "test:flaky": "mkdir -p ../reports && node ../tools/run-flaky-check.mjs ../reports/sidecar-reruns.json -- node --import tsx --import ./src/testing/isolatedTestEnv.ts --test --test-reporter=spec \"src/**/*.test.ts\"",
    "perf:replay": "tsx src/perf/cli.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.270",
    "@factory/droid-sdk": "^0.6.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": {
      "zod": "$zod"
    }
  }
}
